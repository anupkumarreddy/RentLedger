[Unit]
Description=RentLedger Django application
After=network.target

[Service]
Type=notify
User=rentledger
Group=www-data
WorkingDirectory=/srv/apps/rentledger/current
EnvironmentFile=/etc/rentledger/rentledger.env
RuntimeDirectory=rentledger
RuntimeDirectoryMode=0755
UMask=0007
ExecStart=/srv/apps/rentledger/venv/bin/gunicorn \
    --workers 1 \
    --threads 2 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile - \
    --bind unix:/run/rentledger/gunicorn.sock \
    config.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
KillSignal=SIGQUIT
TimeoutStopSec=10
PrivateTmp=true
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
